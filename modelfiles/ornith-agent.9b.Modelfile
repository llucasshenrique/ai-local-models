# Tuned ornith 9B (q4_K_M) for agentic micro-tasks. Measured: 32k ctx = 6.3 GB, 100% GPU, ~66 tok/s;
# even 64k fits (7.4 GB, 67 tok/s). 9/9 opencode smoke runs, no loops.
FROM ornith:9b-q4_K_M
PARAMETER temperature 0.25
PARAMETER top_k 20
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.05
PARAMETER repeat_last_n 256
PARAMETER num_ctx 32768
PARAMETER num_predict 4096
